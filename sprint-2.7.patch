++# 1. Update src/pages/ReferralProgram.jsx to generate unique links
++sed -i 's|const referralLink = "https://onboard01.com/ref/sarah-j";|const [userRef] = useState("EMP" + Math.floor(Math.random() * 900 + 100));\n  const referralLink = `${window.location.origin}/jobs?ref=${userRef}`;|g' src/pages/ReferralProgram.jsx
++
++# 2. Update ApplicationForm.jsx to parse URL param 'ref'
++sed -i '/const navigate = useNavigate();/a \
++  const [searchParams] = useSearchParams();\n  const referralCode = searchParams.get("ref");' src/pages/ApplicationForm.jsx
