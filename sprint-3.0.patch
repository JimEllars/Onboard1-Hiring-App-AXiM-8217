+                  </li>
+                ))}
+              </ul>
+            )}
+          </div>
+        </div>
+
+        <div className="grid grid-cols-1 lg:grid-cols-2 gap-12">"""
+
+content = content.replace('        <div className="grid grid-cols-1 lg:grid-cols-2 gap-12">', ui_code_new)
+
+with open('src/pages/CandidateScores.jsx', 'w') as f:
+    f.write(content)
+
+print("Done")
