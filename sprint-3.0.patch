+    { value: Math.round((interviewCount / totalApplicants) * 100), name: 'Interviewed', itemStyle: { color: '#a78bfa' } },
+    { value: Math.round((offerCount / totalApplicants) * 100), name: 'Offered', itemStyle: { color: '#34d399' } },
